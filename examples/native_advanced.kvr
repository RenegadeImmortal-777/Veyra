fn fib(n: Int) -> Int {
    if n <= 1 { return n; }
    return fib(n - 1) + fib(n - 2);
}
let total = 0;
for n in range(0, 5) {
    total = total + n;
}
let info = {"engine": "rust", "level": 90};
print("fib(10) =", fib(10));
print("sum =", total);
print("engine =", get(info, "engine"));
print("keys =", keys(info));
