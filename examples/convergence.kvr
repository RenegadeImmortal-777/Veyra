class Counter {
    fn init(self, start: Int) -> Void { self.value = start; }
    fn inc(self) -> Int { self.value += 1; return self.value; }
}
let c = Counter(4);
assert(c.inc() == 5, "class failed");
let t = (1, 2, 3);
let s = {1, 2, 3};
assert(len(t) == 3, "tuple failed");
assert(len(s) == 3, "set failed");
try { throw "boom"; } catch err { assert(err == "boom", "catch failed"); }
let pymath = py_import("math");
assert(pymath.sqrt(81) == 9.0, "python bridge failed");
let parsed = json_parse("{\"x\": 7}");
assert(parsed.x == 7, "json member failed");
print("Kovrek convergence runtime OK");
