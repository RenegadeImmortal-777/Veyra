fn get(url: String, timeout_ms: Number) -> Map {
    return http_request("GET", url, {}, null, timeout_ms);
}
fn post(url: String, headers: Map, body: Any, timeout_ms: Number) -> Map {
    return http_request("POST", url, headers, body, timeout_ms);
}
fn request(method: String, url: String, headers: Map, body: Any, timeout_ms: Number) -> Map {
    return http_request(method, url, headers, body, timeout_ms);
}
