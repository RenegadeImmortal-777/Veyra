{
  "name": "kovrek-language",
  "displayName": "Kovrek Language",
  "description": "LSP and DAP Language support for Kovrek",
  "version": "12.0.0",
  "publisher": "kovrek",
  "engines": {"vscode": "^1.80.0"},
  "categories": ["Programming Languages", "Linters", "Debuggers"],
  "activationEvents": ["onLanguage:kovrek", "onDebugInitialConfigurations", "onDebugResolve:kovrek"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{"id":"kovrek","aliases":["Kovrek","kovrek"],"extensions":[".kvr"],"configuration":"./language-configuration.json"}],
    "grammars": [{"language":"kovrek","scopeName":"source.kovrek","path":"./syntaxes/kovrek.tmLanguage.json"}],
    "snippets": [{"language":"kovrek","path":"./snippets/kovrek.json"}],
    "breakpoints": [{"language": "kovrek"}],
    "debuggers": [
      {
        "type": "kovrek",
        "label": "Kovrek Debug",
        "languages": ["kovrek"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a Kovrek .kvr entry file",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launching",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "kovrek",
            "request": "launch",
            "name": "Debug Current Kovrek File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ]
      }
    ],
    "configuration": {
      "title": "Kovrek",
      "properties": {
        "kovrek.executablePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the native Kovrek executable"
        }
      }
    },
    "commands": [
      {"command":"kovrek.check","title":"Kovrek: Check Current File"},
      {"command":"kovrek.run","title":"Kovrek: Run Current File"},
      {"command":"kovrek.debug","title":"Kovrek: Debug Current File"},
      {"command":"kovrek.test","title":"Kovrek: Test Project"},
      {"command":"kovrek.profile","title":"Kovrek: Profile Current File"}
    ]
  }
}
